---
import { localizePath, type Locale } from '../i18n/config';
import { useCommon } from '../i18n/common';

interface Props {
	lang?: Locale;
}
const { lang = 'en' } = Astro.props;
const t = useCommon(lang);
const p = (path: string) => localizePath(path, lang);

const GOOGLE_REVIEWS = 'https://www.google.com/maps/place/Boat+Rental+Zakynthos+Sota+Travel/@37.8407318,20.8180773,17z/data=!4m8!3m7!1s0x13674792fceb7531:0xca2bf80ddaaa1d99!8m2!3d37.8407318!4d20.8206522!9m1!1b1!16s%2Fg%2F11yv91nf_0';
const TRIPADVISOR_REVIEWS = 'https://www.tripadvisor.com/Attraction_Review-g189462-d34338909-Reviews-Sota_Travel_Zakynthos-Zakynthos_Ionian_Islands.html';
---
<footer class="site-footer" aria-label="Footer">
	<div class="footer-main">
		<!-- Brand -->
		<div class="footer-col footer-about">
			<a href={p('/')} class="footer-logo" aria-label="Sota Travel Zakynthos">
				<img class="footer-logo-img" src="/images/sota-travel-logo.svg" alt="Sota Travel Zakynthos" />
			</a>
			<p class="footer-tagline">{t('footer.tagline')}</p>
		</div>

		<!-- Contact Details -->
		<div class="footer-col">
			<h3 class="footer-title">{t('footer.contactDetails')}</h3>
			<p class="footer-line"><strong>Address:</strong> {t('footer.address')}</p>
			<p class="footer-line"><strong>Phone / WhatsApp / Viber:</strong><br /><a href="tel:+306987931327">+30 698 793 1327</a></p>
			<p class="footer-line"><strong>Email:</strong> <a href="mailto:sotatravel1@gmail.com">sotatravel1@gmail.com</a></p>
			<p class="footer-follow">{t('footer.follow')}</p>
			<div class="footer-social">
				<a href="https://www.instagram.com/sota_travel.zakynthos/" target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="Instagram">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
				</a>
				<a href="https://www.facebook.com/SotatravelzakynthoS" target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="Facebook">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
				</a>
			</div>
		</div>

		<!-- Services & Information -->
		<div class="footer-col">
			<h3 class="footer-title">{t('footer.services')}</h3>
			<ul class="footer-links">
				<li><a href={p('/license-free-rent')}>{t('footer.selfDrive')}</a></li>
				<li><a href={p('/rent-with-skipper')}>{t('footer.skipperDrive')}</a></li>
				<li><a href={p('/private-yachting')}>{t('footer.yachting')}</a></li>
				<li><a href={p('/special-celebrations')}>{t('footer.celebrations')}</a></li>
				<li><a href={p('/recommended-routes')}>{t('footer.routes')}</a></li>
				<li><a href={p('/faq')}>{t('footer.faq')}</a></li>
				<li><a href={p('/contact')}>{t('footer.contact')}</a></li>
			</ul>
		</div>

		<!-- Reviews -->
		<div class="footer-col">
			<h3 class="footer-title">{t('footer.reviews')}</h3>
			<ul class="footer-links">
				<li><a href={GOOGLE_REVIEWS} target="_blank" rel="noopener noreferrer">{t('footer.reviewsGoogle')}</a></li>
				<li><a href={TRIPADVISOR_REVIEWS} target="_blank" rel="noopener noreferrer">{t('footer.reviewsTripadvisor')}</a></li>
			</ul>
		</div>
	</div>

	<div class="footer-bottom">
		<p class="footer-copyright">
			© 2026 Sota Travel Zakynthos · <a href="/privacy-policy">{t('footer.privacy')}</a> · <a href="/terms-of-use">{t('footer.terms')}</a> · <a href="/cookie-policy">{t('footer.cookies')}</a>
			<span class="footer-credit">{t('footer.copyright')} <a href="https://www.itdev.gr/" target="_blank" rel="noopener noreferrer">IT DEV</a></span>
		</p>
	</div>
</footer>
<a
	href="https://wa.me/306987931327"
	class="wa-float"
	target="_blank"
	rel="noopener noreferrer"
	aria-label="WhatsApp"
>
	<span class="wa-float__text">{t('footer.whatsappCta')}</span>
	<svg class="wa-float__icon" width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
</a>

<style>
	.wa-float {
		position: fixed;
		bottom: 1.5rem;
		right: 1.5rem;
		z-index: 9999;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.85rem 1.4rem;
		background: #25D366;
		color: #ffffff;
		border-radius: 999px;
		text-decoration: none;
		font-size: 1rem;
		font-weight: 600;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.28);
		transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
	}
	.wa-float:hover {
		background: #1ebe5b;
		transform: translateY(-2px);
		box-shadow: 0 10px 26px rgba(0, 0, 0, 0.34);
	}
	.wa-float__icon {
		flex-shrink: 0;
	}
	@media (max-width: 600px) {
		.wa-float {
			bottom: 1rem;
			right: 1rem;
			padding: 0.8rem 1.2rem;
			font-size: 0.95rem;
		}
	}
</style>

<style>
	.site-footer {
		background: #064250;
		color: #ffffff;
		width: 100%;
	}
	.footer-main {
		display: grid;
		grid-template-columns: 1.4fr 1.1fr 1fr 1fr;
		gap: 2.5rem 3rem;
		max-width: 1200px;
		margin: 0 auto;
		padding: 3.5rem 2rem 3rem;
	}
	.footer-col {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.85rem;
	}
	.footer-logo {
		display: flex;
		text-decoration: none;
		color: inherit;
	}
	.footer-logo-img {
		height: 90px;
		width: auto;
		display: block;
	}
	.footer-tagline {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.65;
		color: #ffffff;
	}
	.footer-title {
		font-size: 1.05rem;
		font-weight: 700;
		margin: 0 0 0.35rem;
		color: #ffffff;
		letter-spacing: 0.01em;
	}
	.footer-line {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: #ffffff;
	}
	.footer-line strong {
		color: #ffffff;
		font-weight: 700;
	}
	.footer-line a {
		color: #ffffff;
		text-decoration: none;
	}
	.footer-line a:hover {
		text-decoration: underline;
	}
	.footer-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.footer-links a {
		color: #ffffff;
		text-decoration: none;
		font-size: 0.9rem;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.footer-links a::before {
		content: '›';
		color: #ffffff;
		font-size: 1rem;
		line-height: 1;
	}
	.footer-links a:hover {
		text-decoration: underline;
	}
	.footer-follow {
		margin: 0.6rem 0 0;
		font-size: 1rem;
		font-weight: 700;
		color: #ffffff;
	}
	.footer-social {
		display: flex;
		flex-direction: row;
		gap: 0.75rem;
		margin-top: 0.25rem;
	}
	.footer-social-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border: 1px solid rgba(255, 255, 255, 0.5);
		border-radius: 999px;
		color: #ffffff;
		text-decoration: none;
		transition: background 0.2s, border-color 0.2s;
	}
	.footer-social-icon:hover {
		background: rgba(255, 255, 255, 0.12);
		border-color: #ffffff;
	}
	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.18);
		padding: 1.15rem 2rem;
	}
	.footer-copyright {
		margin: 0 auto;
		max-width: 1200px;
		font-size: 0.82rem;
		color: #ffffff;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1rem;
	}
	.footer-copyright a {
		color: #ffffff;
		text-decoration: none;
	}
	.footer-copyright a:hover {
		text-decoration: underline;
	}
	.footer-credit {
		color: #ffffff;
	}
	@media (max-width: 900px) {
		.footer-main {
			grid-template-columns: 1fr 1fr;
			padding: 2.5rem 1.5rem 2rem;
		}
	}
	@media (max-width: 600px) {
		.footer-main {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.footer-copyright {
			flex-direction: column;
			font-size: 0.78rem;
		}
	}
</style>
