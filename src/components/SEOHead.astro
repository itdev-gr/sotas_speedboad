---
import {
  LOCALES,
  OG_LOCALE,
  DEFAULT_LOCALE,
  localizePath,
  absoluteUrl,
  type Locale,
} from '../i18n/config';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  /** Active locale of the page. */
  lang?: Locale;
  /** Canonical English path (e.g. '/contact' or '/'). Enables self-canonical + hreflang. */
  basePath?: string;
  /** Whether de/fr/it translations of this page exist (emit hreflang alternates). */
  translated?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://rentaboatzakynthos.com/images/unnamed.jpg',
  ogType = 'website',
  noindex = false,
  lang = 'en',
  basePath,
  translated = false,
} = Astro.props;

const canonicalURL = basePath
  ? absoluteUrl(localizePath(basePath, lang))
  : canonical || new URL(Astro.url.pathname, Astro.site).href;

const alternates =
  translated && basePath
    ? LOCALES.map((l) => ({ hreflang: l, href: absoluteUrl(localizePath(basePath, l as Locale)) }))
    : [];
---

<meta charset="utf-8" />

<!-- Google tag (gtag.js) — deferred off the critical path -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-XX59D06X4W');
  gtag('config', 'AW-18123954099');
  (function () {
    var loaded = false;
    function loadGtag() {
      if (loaded) return; loaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-XX59D06X4W';
      document.head.appendChild(s);
    }
    ['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach(function (e) {
      window.addEventListener(e, loadGtag, { once: true, passive: true });
    });
    if ('requestIdleCallback' in window) { requestIdleCallback(loadGtag, { timeout: 5000 }); }
    else { setTimeout(loadGtag, 3500); }
  })();
</script>

<!-- Microsoft Clarity — deferred off the critical path -->
<script is:inline type="text/javascript">
  (function () {
    var loaded = false;
    function loadClarity() {
      if (loaded) return; loaded = true;
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "xgop1tmc37");
    }
    ['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach(function (e) {
      window.addEventListener(e, loadClarity, { once: true, passive: true });
    });
    if ('requestIdleCallback' in window) { requestIdleCallback(loadClarity, { timeout: 6000 }); }
    else { setTimeout(loadClarity, 4000); }
  })();
</script>

<!-- Event snippet for Προβολή σελίδας conversion page -->
<script is:inline>
  function gtag_report_conversion(url) {
    var callback = function () {
      if (typeof(url) != 'undefined') {
        window.location = url;
      }
    };
    gtag('event', 'conversion', {
        'send_to': 'AW-18123954099/h8FuCOeMwMUcELOvlsJD',
        'event_callback': callback
    });
    return false;
  }

  // Fire the Google Ads conversion when users click contact / booking actions.
  document.addEventListener('click', function (e) {
    var link = e.target && e.target.closest ? e.target.closest('a') : null;
    if (!link) return;
    var href = link.getAttribute('href') || '';
    var isConversion =
      href.indexOf('tel:') === 0 ||
      href.indexOf('wa.me') !== -1 ||
      href.indexOf('/contact') === 0 ||
      href === '/license-free-rent' ||
      href === '/rent-with-skipper' ||
      href === '/private-yachting' ||
      (link.className && String(link.className).indexOf('floating-contact__item') !== -1);
    if (!isConversion) return;
    gtag('event', 'conversion', {
      'send_to': 'AW-18123954099/h8FuCOeMwMUcELOvlsJD'
    });
  }, true);
</script>

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- hreflang alternates -->
{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
))}
{alternates.length > 0 && (
  <link rel="alternate" hreflang="x-default" href={absoluteUrl(localizePath(basePath!, DEFAULT_LOCALE))} />
)}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImage} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Sota Travel Zakynthos" />
<meta property="og:locale" content={OG_LOCALE[lang]} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Geo tags for local SEO -->
<meta name="geo.region" content="GR-21" />
<meta name="geo.placename" content="Zakynthos" />
<meta name="geo.position" content="37.8407318;20.8206522" />
<meta name="ICBM" content="37.8407318, 20.8206522" />

<!-- Fonts (async, non-render-blocking) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
  onload="this.onload=null;this.rel='stylesheet'"
/>
<noscript>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
</noscript>
