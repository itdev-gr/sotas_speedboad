---
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { localizePath, type Locale } from '../../i18n/config';
import { useCommon } from '../../i18n/common';
import { faq } from '../../i18n/pages/faq';

interface Props {
	lang: Locale;
}
const { lang } = Astro.props;
const s = faq[lang];
const c = useCommon(lang);
const contactHref = localizePath('/contact', lang);
---
<body class="faq-page-body min-h-screen font-sans antialiased overflow-x-hidden" style="font-family: 'Inter', system-ui, sans-serif;">
	<Header lang={lang} basePath="/faq" />
	<main class="min-h-screen">
		<!-- Hero (same as before) -->
		<section class="relative w-full min-h-[40vh] flex items-center justify-center overflow-hidden pt-20 pb-12" style="background: linear-gradient(135deg, #064250 0%, #0a5a6a 100%);" aria-label={s.heroAria}>
			<div class="absolute inset-0" style="background: url('/images/IMG_6416.webp') center/cover no-repeat; opacity: 0.25;"></div>
			<div class="relative z-10 text-center px-8 py-6 max-w-xl">
				<h1 class="font-serif text-3xl md:text-4xl font-semibold text-white mb-3 leading-tight" style="font-family: 'Cormorant Garamond', serif;">{s.heroTitle}</h1>
				<p class="text-base text-white/90 leading-relaxed">{s.heroSubtitle}</p>
			</div>
		</section>

		<!-- FAQ accordion (template) -->
		<section class="py-24 bg-[#f5f0e8]" aria-label={s.sectionAria}>
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="accordion-group">
					<div class="accordion py-8 px-6 border-b border-solid border-[#e0ddd8] transition-all duration-300 rounded-2xl hover:bg-white/60" id="faq-heading-1">
						<button type="button" class="accordion-toggle group inline-flex items-center justify-between leading-8 text-[#1a1a1a] w-full transition duration-300 text-left hover:text-[#064250]" aria-controls="faq-collapse-1" aria-expanded="false" id="faq-btn-1">
							<h5 class="text-left">{s.q1}</h5>
							<svg class="text-[#333] transition duration-300 group-hover:text-[#064250] shrink-0" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<path d="M16.5 8.25L12.4142 12.3358C11.7475 13.0025 11.4142 13.3358 11 13.3358C10.5858 13.3358 10.2525 13.0025 9.58579 12.3358L5.5 8.25" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<div id="faq-collapse-1" class="accordion-content w-full overflow-hidden transition-all duration-300" aria-labelledby="faq-heading-1" role="region">
							<p class="text-base text-[#333] leading-6 pt-2">{s.a1}</p>
						</div>
					</div>

					<div class="accordion py-8 px-6 border-b border-solid border-[#e0ddd8] transition-all duration-300 rounded-2xl hover:bg-white/60" id="faq-heading-2">
						<button type="button" class="accordion-toggle group inline-flex items-center justify-between leading-8 text-[#1a1a1a] w-full transition duration-300 text-left hover:text-[#064250]" aria-controls="faq-collapse-2" aria-expanded="false" id="faq-btn-2">
							<h5 class="text-left">{s.q2}</h5>
							<svg class="text-[#333] transition duration-300 group-hover:text-[#064250] shrink-0" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<path d="M16.5 8.25L12.4142 12.3358C11.7475 13.0025 11.4142 13.3358 11 13.3358C10.5858 13.3358 10.2525 13.0025 9.58579 12.3358L5.5 8.25" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<div id="faq-collapse-2" class="accordion-content w-full overflow-hidden transition-all duration-300" aria-labelledby="faq-heading-2" role="region">
							<p class="text-base text-[#333] leading-6 pt-2">{s.a2}</p>
						</div>
					</div>

					<div class="accordion py-8 px-6 border-b border-solid border-[#e0ddd8] transition-all duration-300 rounded-2xl hover:bg-white/60" id="faq-heading-3">
						<button type="button" class="accordion-toggle group inline-flex items-center justify-between leading-8 text-[#1a1a1a] w-full transition duration-300 text-left hover:text-[#064250]" aria-controls="faq-collapse-3" aria-expanded="false" id="faq-btn-3">
							<h5 class="text-left">{s.q3}</h5>
							<svg class="text-[#333] transition duration-300 group-hover:text-[#064250] shrink-0" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<path d="M16.5 8.25L12.4142 12.3358C11.7475 13.0025 11.4142 13.3358 11 13.3358C10.5858 13.3358 10.2525 13.0025 9.58579 12.3358L5.5 8.25" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<div id="faq-collapse-3" class="accordion-content w-full overflow-hidden transition-all duration-300" aria-labelledby="faq-heading-3" role="region">
							<p class="text-base text-[#333] leading-6 pt-2">{s.a3}</p>
						</div>
					</div>

					<div class="accordion py-8 px-6 border-b border-solid border-[#e0ddd8] transition-all duration-300 rounded-2xl hover:bg-white/60" id="faq-heading-4">
						<button type="button" class="accordion-toggle group inline-flex items-center justify-between leading-8 text-[#1a1a1a] w-full transition duration-300 text-left hover:text-[#064250]" aria-controls="faq-collapse-4" aria-expanded="false" id="faq-btn-4">
							<h5 class="text-left">{s.q4}</h5>
							<svg class="text-[#333] transition duration-300 group-hover:text-[#064250] shrink-0" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<path d="M16.5 8.25L12.4142 12.3358C11.7475 13.0025 11.4142 13.3358 11 13.3358C10.5858 13.3358 10.2525 13.0025 9.58579 12.3358L5.5 8.25" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<div id="faq-collapse-4" class="accordion-content w-full overflow-hidden transition-all duration-300" aria-labelledby="faq-heading-4" role="region">
							<p class="text-base text-[#333] leading-6 pt-2">{s.a4}</p>
						</div>
					</div>

					<div class="accordion py-8 px-6 border-b border-solid border-[#e0ddd8] transition-all duration-300 rounded-2xl hover:bg-white/60" id="faq-heading-5">
						<button type="button" class="accordion-toggle group inline-flex items-center justify-between leading-8 text-[#1a1a1a] w-full transition duration-300 text-left hover:text-[#064250]" aria-controls="faq-collapse-5" aria-expanded="false" id="faq-btn-5">
							<h5 class="text-left">{s.q5}</h5>
							<svg class="text-[#333] transition duration-300 group-hover:text-[#064250] shrink-0" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<path d="M16.5 8.25L12.4142 12.3358C11.7475 13.0025 11.4142 13.3358 11 13.3358C10.5858 13.3358 10.2525 13.0025 9.58579 12.3358L5.5 8.25" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<div id="faq-collapse-5" class="accordion-content w-full overflow-hidden transition-all duration-300" aria-labelledby="faq-heading-5" role="region">
							<p class="text-base text-[#333] leading-6 pt-2">{s.a5}</p>
						</div>
					</div>

					<div class="accordion py-8 px-6 border-b border-solid border-[#e0ddd8] transition-all duration-300 rounded-2xl hover:bg-white/60" id="faq-heading-6">
						<button type="button" class="accordion-toggle group inline-flex items-center justify-between leading-8 text-[#1a1a1a] w-full transition duration-300 text-left hover:text-[#064250]" aria-controls="faq-collapse-6" aria-expanded="false" id="faq-btn-6">
							<h5 class="text-left">{s.q6}</h5>
							<svg class="text-[#333] transition duration-300 group-hover:text-[#064250] shrink-0" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<path d="M16.5 8.25L12.4142 12.3358C11.7475 13.0025 11.4142 13.3358 11 13.3358C10.5858 13.3358 10.2525 13.0025 9.58579 12.3358L5.5 8.25" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<div id="faq-collapse-6" class="accordion-content w-full overflow-hidden transition-all duration-300" aria-labelledby="faq-heading-6" role="region">
							<p class="text-base text-[#333] leading-6 pt-2">{s.a6}</p>
						</div>
					</div>

					<div class="accordion py-8 px-6 transition-all duration-300 rounded-2xl hover:bg-white/60" id="faq-heading-7">
						<button type="button" class="accordion-toggle group inline-flex items-center justify-between leading-8 text-[#1a1a1a] w-full transition duration-300 text-left hover:text-[#064250]" aria-controls="faq-collapse-7" aria-expanded="false" id="faq-btn-7">
							<h5 class="text-left">{s.q7}</h5>
							<svg class="text-[#333] transition duration-300 group-hover:text-[#064250] shrink-0" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<path d="M16.5 8.25L12.4142 12.3358C11.7475 13.0025 11.4142 13.3358 11 13.3358C10.5858 13.3358 10.2525 13.0025 9.58579 12.3358L5.5 8.25" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<div id="faq-collapse-7" class="accordion-content w-full overflow-hidden transition-all duration-300" aria-labelledby="faq-heading-7" role="region">
							<p class="text-base text-[#333] leading-6 pt-2">{s.a7}</p>
						</div>
					</div>
				</div>

				<p class="text-center mt-10">
					<a href={contactHref} class="inline-block py-3 px-8 bg-[#064250] text-white text-sm font-semibold rounded hover:bg-[#0a5a6a] transition-colors">{s.ctaContact}</a>
				</p>
			</div>
		</section>
	</main>
	<Footer lang={lang} />

	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const header = document.querySelector('.hero-header');
			const heroSection = document.querySelector('.hero');
			if (header) {
				if (!heroSection) {
					header.classList.add('hero-header--scrolled');
				} else {
					const onScroll = () => {
						const heroH = heroSection.getBoundingClientRect().height;
						header.classList.toggle('hero-header--scrolled', window.scrollY >= heroH - 1);
					};
					onScroll();
					window.addEventListener('scroll', onScroll, { passive: true });
				}
			}
			// FAQ accordion: only one open at a time, max-height animation
			const accordionGroup = document.querySelector('.accordion-group');
			if (accordionGroup) {
				accordionGroup.addEventListener('click', (e) => {
					const btn = e.target.closest('.accordion-toggle');
					if (!btn) return;
					const accordion = btn.closest('.accordion');
					const content = document.getElementById(btn.getAttribute('aria-controls'));
					if (!accordion || !content) return;
					const isOpen = accordion.classList.contains('active');
					// Close all others
					accordionGroup.querySelectorAll('.accordion').forEach((el) => {
						el.classList.remove('active');
						const otherBtn = el.querySelector('.accordion-toggle');
						const otherContent = otherBtn && document.getElementById(otherBtn.getAttribute('aria-controls'));
						if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
						if (otherContent) otherContent.style.maxHeight = '';
					});
					if (!isOpen) {
						accordion.classList.add('active');
						btn.setAttribute('aria-expanded', 'true');
						content.style.maxHeight = content.scrollHeight + 'px';
					}
				});
			}
		});
	</script>
</body>

<style is:global>
	html { scroll-behavior: smooth; }
	body.faq-page-body { padding-top: 0; }
</style>

<style>
	/* Accordion content: closed by default */
	.accordion-content {
		max-height: 0;
		transition: max-height 0.35s ease;
	}
	/* Active state: accent color and chevron rotation */
	.accordion.active {
		background: rgba(245, 240, 232, 0.9);
	}
	.accordion.active .accordion-toggle {
		font-weight: 600;
		color: #064250;
	}
	.accordion.active .accordion-toggle svg {
		transform: rotate(180deg);
		color: #064250;
	}
</style>
