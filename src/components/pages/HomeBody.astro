---
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { localizePath, type Locale } from '../../i18n/config';
import { useCommon } from '../../i18n/common';
import { home } from '../../i18n/pages/home';

interface Props {
	lang: Locale;
}
const { lang } = Astro.props;
const s = home[lang];
const c = useCommon(lang);
---

	<body>
		<section class="hero" aria-label="Hero section">
			<!-- Fullscreen image background -->
			<div class="hero-image-wrap">
				<img
					class="hero-image is-ready"
					src="/images/unnamed.jpg"
					alt="Zakynthos boat cruise"
					aria-hidden="true"
					data-hero-image
				/>
				<video
					class="hero-video"
					src="/videos/hero.mp4"
					muted
					playsinline
					preload="metadata"
					aria-hidden="true"
					data-hero-video
				></video>
				<div class="hero-overlay" aria-hidden="true"></div>
			</div>

			<Header lang={lang} basePath="/" />

			<!-- Carousel arrows -->
			<button class="hero-arrow hero-arrow-prev" type="button" aria-label={s.arrowPrev}>
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<polyline points="15 18 9 12 15 6" />
				</svg>
			</button>
			<button class="hero-arrow hero-arrow-next" type="button" aria-label={s.arrowNext}>
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<polyline points="9 18 15 12 9 6" />
				</svg>
			</button>

			<!-- Hero content (first video – left) -->
			<div class="hero-content">
				<p class="hero-label">{s.heroLabel}</p>
				<h1 class="hero-title">
					<span>{s.slide1TitleA}</span>
					<span>{s.slide1TitleB}</span>
				</h1>
				<p class="hero-subtitle">{s.slide1Sub}</p>
				<a href={localizePath('/contact', lang)} class="hero-cta">{s.ctaContact}</a>
			</div>

			<!-- Hero content (second image – right) -->
			<div class="hero-content-second" aria-hidden="true">
				<p class="hero-label">{s.heroLabel}</p>
				<h2 class="hero-title">
					<span>{s.slide2TitleA}</span>
					<span>{s.slide2TitleB}</span>
				</h2>
				<p class="hero-subtitle">{s.slide2Sub}</p>
				<a href={localizePath('/contact', lang)} class="hero-cta">{s.ctaContact}</a>
			</div>

			<!-- Hero content (video slide – left) -->
			<div class="hero-content-video" aria-hidden="true">
				<p class="hero-label">{s.heroLabel}</p>
				<h2 class="hero-title">
					<span>{s.slide3TitleA}</span>
					<span>{s.slide3TitleB}</span>
				</h2>
				<p class="hero-subtitle">{s.slide3Sub}</p>
				<a href={localizePath('/private-yachting', lang)} class="hero-cta">{s.ctaViewMore}</a>
			</div>
		</section>

		<!-- Services bar -->
		<section class="services-bar" aria-label="Our services">
			<div class="services-bar-inner">
				<a href={localizePath('/private-yachting', lang)} class="services-bar-item">
					<svg class="services-bar-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M32 6L14 18v28l18 12 18-12V18L32 6z" stroke="currentColor" stroke-width="2" fill="none"/>
						<rect x="24" y="28" width="16" height="18" rx="2" stroke="currentColor" stroke-width="2" fill="none"/>
						<path d="M28 28v-4a4 4 0 018 0v4" stroke="currentColor" stroke-width="2" fill="none"/>
					</svg>
					<span class="services-bar-label">{s.svcYachting}</span>
				</a>
				<div class="services-bar-divider"></div>
				<a href={localizePath('/rent-with-skipper', lang)} class="services-bar-item">
					<svg class="services-bar-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
						<circle cx="32" cy="10" r="3" stroke="currentColor" stroke-width="2"/>
						<line x1="32" y1="13" x2="32" y2="54" stroke="currentColor" stroke-width="2"/>
						<line x1="22" y1="54" x2="42" y2="54" stroke="currentColor" stroke-width="2"/>
						<path d="M24 22c4 4 12 4 16 0" stroke="currentColor" stroke-width="2" fill="none"/>
						<path d="M22 32c5 5 15 5 20 0" stroke="currentColor" stroke-width="2" fill="none"/>
					</svg>
					<span class="services-bar-label">{s.svcSkipper}</span>
				</a>
				<div class="services-bar-divider"></div>
				<a href={localizePath('/license-free-rent', lang)} class="services-bar-item">
					<svg class="services-bar-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
						<circle cx="32" cy="32" r="18" stroke="currentColor" stroke-width="2"/>
						<circle cx="32" cy="32" r="4" stroke="currentColor" stroke-width="2"/>
						<line x1="32" y1="14" x2="32" y2="24" stroke="currentColor" stroke-width="2"/>
						<line x1="32" y1="40" x2="32" y2="50" stroke="currentColor" stroke-width="2"/>
						<line x1="14" y1="32" x2="24" y2="32" stroke="currentColor" stroke-width="2"/>
						<line x1="40" y1="32" x2="50" y2="32" stroke="currentColor" stroke-width="2"/>
						<line x1="19.3" y1="19.3" x2="25.5" y2="25.5" stroke="currentColor" stroke-width="2"/>
						<line x1="38.5" y1="38.5" x2="44.7" y2="44.7" stroke="currentColor" stroke-width="2"/>
						<line x1="44.7" y1="19.3" x2="38.5" y2="25.5" stroke="currentColor" stroke-width="2"/>
						<line x1="25.5" y1="38.5" x2="19.3" y2="44.7" stroke="currentColor" stroke-width="2"/>
					</svg>
					<span class="services-bar-label">{s.svcSelfDrive}</span>
				</a>
				<div class="services-bar-divider"></div>
				<a href={localizePath('/special-celebrations', lang)} class="services-bar-item">
					<svg class="services-bar-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
						<rect x="20" y="8" width="24" height="6" rx="1" stroke="currentColor" stroke-width="2"/>
						<path d="M22 14v4h20v-4" stroke="currentColor" stroke-width="2" fill="none"/>
						<line x1="24" y1="18" x2="24" y2="52" stroke="currentColor" stroke-width="2"/>
						<line x1="40" y1="18" x2="40" y2="52" stroke="currentColor" stroke-width="2"/>
						<path d="M24 18c0 8 16 8 16 18" stroke="currentColor" stroke-width="1.5" fill="none"/>
						<path d="M24 24c0 6 16 6 16 14" stroke="currentColor" stroke-width="1.5" fill="none"/>
						<line x1="20" y1="52" x2="44" y2="52" stroke="currentColor" stroke-width="2"/>
					</svg>
					<span class="services-bar-label">{s.svcCelebrations}</span>
				</a>
			</div>
		</section>

		<!-- Pillar intro section -->
		<section class="home-intro" aria-label={s.introTitle}>
			<div class="home-intro-inner">
				<p class="home-intro-label">{s.introLabel}</p>
				<h2 class="home-intro-title">{s.introTitle}</h2>
				<p class="home-intro-text">{s.introP1}</p>
				<p class="home-intro-text">{s.introP2}</p>
				<p class="home-intro-text">{s.introP3}</p>
			</div>
		</section>

		<!-- Third section: Self Drive Boat Rentals -->
		<section class="selfdrive-section" id="selfdrive" aria-label="Self drive boat rentals">
			<div class="selfdrive-inner">
				<div class="selfdrive-image-wrap">
					<img
						src="/images/license-free-hero.png"
						alt={s.sd1Alt}
						class="selfdrive-image selfdrive-image--fit"
						width="800"
						height="600"
					/>
				</div>
				<div class="selfdrive-text">
					<span class="selfdrive-bg-label" aria-hidden="true">SELF DRIVE</span>
					<p class="selfdrive-sub">{s.sd1Sub}</p>
					<h2 class="selfdrive-title">{s.sd1Title}</h2>
					<p class="selfdrive-desc">
						{s.sd1Desc}
					</p>
					<a href={localizePath('/license-free-rent', lang)} class="selfdrive-cta">{s.ctaViewMore}</a>
				</div>
			</div>
		</section>

		<!-- Skipper Drive section (image right, text left) -->
		<section class="selfdrive-section selfdrive-section--last" id="skipperdrive" aria-label="Skipper drive boat rentals">
			<div class="selfdrive-inner">
				<div class="selfdrive-image-wrap">
					<img
						src="/images/image_skipper.png"
						alt={s.sd2Alt}
						class="selfdrive-image"
						width="800"
						height="600"
					/>
				</div>
				<div class="selfdrive-text">
					<span class="selfdrive-bg-label" aria-hidden="true">SKIPPER DRIVE</span>
					<p class="selfdrive-sub">{s.sd2Sub}</p>
					<h2 class="selfdrive-title">{s.sd2Title}</h2>
					<p class="selfdrive-desc">
						{s.sd2Desc}
					</p>
					<a href={localizePath('/rent-with-skipper', lang)} class="selfdrive-cta">{s.ctaViewMore}</a>
				</div>
			</div>
		</section>

		<!-- Private Yachting section (image left, text right) -->
		<section class="selfdrive-section" id="privateyachting" aria-label="Private yachting">
			<div class="selfdrive-inner">
				<div class="selfdrive-image-wrap">
					<img
						src="/images/IMG_0111.jpeg"
						alt={s.sd3Alt}
						class="selfdrive-image"
						width="800"
						height="600"
					/>
				</div>
				<div class="selfdrive-text">
					<span class="selfdrive-bg-label" aria-hidden="true">PRIVATE YACHTING</span>
					<p class="selfdrive-sub">{s.sd3Sub}</p>
					<h2 class="selfdrive-title">{s.sd3Title}</h2>
					<p class="selfdrive-desc">
						{s.sd3Desc}
					</p>
					<a href={localizePath('/private-yachting', lang)} class="selfdrive-cta">{s.ctaViewMore}</a>
				</div>
			</div>
		</section>

		<!-- Special Celebrations section (text left, image right) -->
		<section class="selfdrive-section selfdrive-section--last" id="specialcelebrations" aria-label="Special celebrations">
			<div class="selfdrive-inner">
				<div class="selfdrive-image-wrap">
					<img
						src="/images/0DF67F7B-8AA7-476C-BCEB-37E088D4925A.png"
						alt={s.sd4Alt}
						class="selfdrive-image"
						width="800"
						height="600"
					/>
				</div>
				<div class="selfdrive-text">
					<span class="selfdrive-bg-label" aria-hidden="true">CELEBRATIONS</span>
					<p class="selfdrive-sub">{s.sd4Sub}</p>
					<h2 class="selfdrive-title">{s.sd4Title}</h2>
					<p class="selfdrive-desc">
						{s.sd4Desc}
					</p>
					<a href={localizePath('/special-celebrations', lang)} class="selfdrive-cta">{s.ctaViewMore}</a>
				</div>
			</div>
		</section>

		<!-- Reviews / social proof -->
		<section class="reviews-section" aria-label="Guest reviews">
			<div class="reviews-inner">
				<p class="reviews-label">{s.reviewsLabel}</p>
				<h2 class="reviews-title">{s.reviewsTitle}</h2>
				<p class="reviews-rating"><span class="reviews-stars" aria-hidden="true">★★★★★</span> {s.reviewsRated}</p>
				<div class="reviews-cards">
					<figure class="review-card">
						<span class="review-stars" aria-hidden="true">★★★★★</span>
						<blockquote>"What an excellent day. Ilias went out of his way to make sure our trip went smoothly. Petros our skipper was superb and very knowledgeable about all the sites we visited."</blockquote>
						<figcaption>— Chris D · TripAdvisor</figcaption>
					</figure>
					<figure class="review-card">
						<span class="review-stars" aria-hidden="true">★★★★★</span>
						<blockquote>"Nice boat and friendly staff. Everything was well arranged — thank you, everyone!"</blockquote>
						<figcaption>— Stein M · TripAdvisor</figcaption>
					</figure>
				</div>
				<div class="reviews-badges">
					<a class="review-badge-link" href="https://www.google.com/maps/place/Boat+Rental+Zakynthos+Sota+Travel/@37.8407318,20.8206522,17z/data=!4m8!3m7!1s0x13674792fceb7531:0xca2bf80ddaaa1d99!8m2!3d37.8407318!4d20.8206522!9m1!1b1" target="_blank" rel="noopener noreferrer" aria-label={s.reviewGoogleCta}>
						<img class="review-badge" src="/images/google-reviews.png" alt="Google Reviews" width="360" height="180" loading="lazy" />
					</a>
					<a class="review-badge-link" href="https://www.tripadvisor.com/Attraction_Review-g189462-d34338909-Reviews-Sota_Travel_Zakynthos-Zakynthos_Ionian_Islands.html" target="_blank" rel="noopener noreferrer" aria-label={s.reviewTaCta}>
						<img class="review-badge review-badge--ta" src="/images/tripadvisor.png" alt="Tripadvisor" width="557" height="122" loading="lazy" />
					</a>
				</div>
			</div>
		</section>

		<Footer lang={lang} />

		<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/gsap.min.js"></script>
		<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
			// GSAP hover animation for services bar icons
			document.querySelectorAll('.services-bar-icon').forEach(function(icon) {
				icon.parentElement.addEventListener('mouseenter', function() {
					gsap.to(icon, { rotation: 15, duration: 0.3, ease: 'power2.out' });
				});
				icon.parentElement.addEventListener('mouseleave', function() {
					gsap.to(icon, { rotation: -15, duration: 0.2, ease: 'power2.inOut',
						onComplete: function() {
							gsap.to(icon, { rotation: 0, duration: 0.3, ease: 'elastic.out(1, 0.5)' });
						}
					});
				});
			});

			const heroImage = document.querySelector('[data-hero-image]');
			const heroVideo = document.querySelector('[data-hero-video]');
			const heroContent = document.querySelector('.hero-content');
			const heroContentSecond = document.querySelector('.hero-content-second');
			const heroContentVideo = document.querySelector('.hero-content-video');
			const prevBtn = document.querySelector('.hero-arrow-prev');
			const nextBtn = document.querySelector('.hero-arrow-next');

			if (heroImage) {
				const slides = [
					{ type: 'image', src: '/images/unnamed.jpg' },
					{ type: 'image', src: '/images/girlinwoater.jpg' },
					{ type: 'video' }
				];
				let currentIndex = 0;
				let autoTimer = null;

				function goToSlide(index) {
					currentIndex = ((index % slides.length) + slides.length) % slides.length;
					const slide = slides[currentIndex];
					const wrap = heroImage.closest('.hero-image-wrap');

					// Stop video if leaving video slide
					if (heroVideo) {
						heroVideo.pause();
						heroVideo.currentTime = 0;
					}

					if (slide.type === 'image') {
						// Show image, hide video
						heroImage.classList.remove('is-ready');
						heroImage.src = slide.src;
						heroImage.onload = () => heroImage.classList.add('is-ready');
						heroImage.style.display = '';
						if (heroVideo) heroVideo.classList.remove('hero-video--active');
						wrap.classList.toggle('hero-image-wrap--hero2', currentIndex === 1);
						resetAutoPlay();
					} else {
						// Show video, hide image
						heroImage.classList.remove('is-ready');
						heroImage.style.display = 'none';
						wrap.classList.remove('hero-image-wrap--hero2');
						if (heroVideo) {
							heroVideo.classList.add('hero-video--active');
							heroVideo.currentTime = 0;
							heroVideo.play();
						}
						// When video ends, go to first slide
						if (autoTimer) clearTimeout(autoTimer);
					}

					// Toggle text content per slide
					heroContent?.classList.toggle('hero-content--hidden', currentIndex !== 0);
					heroContentSecond?.classList.toggle('hero-content-second--visible', currentIndex === 1);
					heroContentVideo?.classList.toggle('hero-content-video--visible', currentIndex === 2);
				}

				function resetAutoPlay() {
					if (autoTimer) clearTimeout(autoTimer);
					autoTimer = setTimeout(() => goToSlide(currentIndex + 1), 6000);
				}

				// When video ends, loop back to first image
				if (heroVideo) {
					heroVideo.addEventListener('ended', () => goToSlide(0));
				}

				resetAutoPlay();

				if (prevBtn) prevBtn.addEventListener('click', (e) => { e.preventDefault(); goToSlide(currentIndex - 1); });
				if (nextBtn) nextBtn.addEventListener('click', (e) => { e.preventDefault(); goToSlide(currentIndex + 1); });
			}

			const header = document.querySelector('.hero-header');
			const heroSection = document.querySelector('.hero');
			if (header && heroSection) {
				const onScroll = () => {
					const heroH = heroSection.getBoundingClientRect().height;
					header.classList.toggle('hero-header--scrolled', window.scrollY >= heroH - 1);
				};
				onScroll();
				window.addEventListener('scroll', onScroll, { passive: true });
			}
			});
		</script>
		<script is:inline>
			(function() {
				var script = document.createElement('script');
				script.src = 'https://cbl.link/b/foZ1bvN.js';
				script.async = true;
				document.head.appendChild(script);
			})();
		</script>

		<script is:inline>
			gsap.registerPlugin(ScrollTrigger);

			document.addEventListener('DOMContentLoaded', function () {
				// Services bar – fade up
				gsap.from('.services-bar', {
					scrollTrigger: { trigger: '.services-bar', start: 'top 60%', toggleActions: 'play none none none' },
					y: 40, opacity: 0, duration: 1.2, ease: 'power2.out'
				});

				// Selfdrive sections – alternate left/right
				document.querySelectorAll('.selfdrive-section').forEach(function (section, i) {
					var imageWrap = section.querySelector('.selfdrive-image-wrap');
					var text = section.querySelector('.selfdrive-text');
					var isEven = i % 2 === 0;

					if (imageWrap) {
						gsap.from(imageWrap, {
							scrollTrigger: { trigger: section, start: '40% 100%', toggleActions: 'play none none none' },
							x: isEven ? -80 : 80, opacity: 0, duration: 1.35, ease: 'power2.out'
						});
					}
					if (text) {
						gsap.from(text, {
							scrollTrigger: { trigger: section, start: '40% 100%', toggleActions: 'play none none none' },
							x: isEven ? 80 : -80, opacity: 0, duration: 1.35, delay: 0.2, ease: 'power2.out'
						});
					}
				});

				// Footer – fade up
				gsap.from('.site-footer', {
					scrollTrigger: { trigger: '.site-footer', start: 'top 60%', toggleActions: 'play none none none' },
					y: 40, opacity: 0, duration: 1.2, ease: 'power2.out'
				});
			});
		</script>
	</body>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html {
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		font-family: 'Inter', system-ui, sans-serif;
		overflow-x: hidden;
	}
</style>

<style>
	.hero {
		position: relative;
		width: 100%;
		height: 100vh;
		min-height: 500px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		padding-top: 5rem;
	}

	/* Image container – fullscreen */
	.hero-image-wrap {
		position: absolute;
		inset: 0;
		z-index: 0;
		background: #000;
	}
	.hero-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 0.8s ease;
	}
	.hero-image.is-ready {
		opacity: 1;
	}
	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 0.8s ease;
	}
	.hero-video.hero-video--active {
		opacity: 1;
	}
	.hero-image-wrap--hero2 .hero-image {
		object-position: center bottom;
	}
	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom,
			rgba(10, 22, 40, 0.35) 0%,
			rgba(10, 22, 40, 0.2) 50%,
			rgba(10, 22, 40, 0.5) 100%
		);
		pointer-events: none;
	}

	/* Carousel arrows */
	.hero-arrow {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 10;
		width: 48px;
		height: 48px;
		border: none;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.15);
		backdrop-filter: blur(4px);
		color: #fff;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background 0.2s, transform 0.2s;
	}
	.hero-arrow:hover {
		background: rgba(255, 255, 255, 0.3);
		transform: translateY(-50%) scale(1.05);
	}
	.hero-arrow-prev {
		left: 1.5rem;
	}
	.hero-arrow-next {
		right: 1.5rem;
	}

	/* Hero content */
	.hero-content {
		position: absolute;
		z-index: 2;
		max-width: 90%;
		padding: 2rem;
		text-align: right;
		right: 8%;
		top: 65%;
		transform: translateY(-50%);
		animation: heroContentIn 1s ease-out forwards;
		opacity: 0;
	}
	@keyframes heroContentIn {
		from {
			opacity: 0;
			transform: translateY(calc(-50% + 32px));
		}
		to {
			opacity: 1;
			transform: translateY(-50%);
		}
	}
	.hero-content.hero-content--hidden {
		animation: heroContentOut 0.5s ease-in forwards;
		pointer-events: none;
	}
	@keyframes heroContentOut {
		from {
			opacity: 1;
			transform: translateY(-50%);
		}
		to {
			opacity: 0;
			transform: translateY(calc(-50% - 24px));
		}
	}

	/* Hero content for second video (right side) */
	.hero-content-second {
		position: absolute;
		z-index: 2;
		max-width: 90%;
		padding: 2rem;
		text-align: right;
		right: 8%;
		top: 50%;
		transform: translateY(-50%);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.5s ease, transform 0.5s ease;
	}
	.hero-content-second.hero-content-second--visible {
		opacity: 1;
		pointer-events: auto;
