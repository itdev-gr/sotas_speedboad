---
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { localizePath, type Locale } from '../../i18n/config';
import { useCommon } from '../../i18n/common';
import { specialCelebrations } from '../../i18n/pages/special-celebrations';

interface Props {
	lang: Locale;
}
const { lang } = Astro.props;
const s = specialCelebrations[lang];
const c = useCommon(lang);
const contactHref = localizePath('/contact', lang);
---
<body class="license-free-body">
	<Header lang={lang} basePath="/special-celebrations" />
	<main class="license-free-page">
		<section class="page-hero" aria-label={s.heroAria}>
			<div class="page-hero-overlay"></div>
			<div class="page-hero-content">
				<h1 class="page-hero-title">{s.heroTitle}</h1>
				<p class="page-hero-subtitle">{s.heroSubtitle}</p>
				<a href={contactHref} class="page-hero-cta">{c('cta.contactToBook')}</a>
			</div>
		</section>

		<!-- Section 1: Full-width text -->
		<section class="py-section" aria-label={s.sec1Aria}>
			<div class="py-section-inner py-section-inner--full">
				<div class="py-text py-text--full">
					<p class="py-label">{s.sec1Label}</p>
					<h2 class="py-title">{s.sec1Title}</h2>
					<p class="py-desc">{s.sec1Desc}</p>
					<a href={contactHref} class="py-cta">{s.sec1Cta}</a>
				</div>
			</div>
		</section>

		<!-- Section 2: Text left, Image right -->
		<section class="py-section py-section--reversed" aria-label={s.sec2Aria}>
			<div class="py-section-inner">
				<div class="py-image-wrap">
					<img src="/images/unnamed.webp" alt={s.sec2Alt} width="800" height="600" />
				</div>
				<div class="py-text">
					<p class="py-label">{s.sec2Label}</p>
					<h2 class="py-title">{s.sec2Title}</h2>
					<p class="py-desc">{s.sec2Desc}</p>
					<a href={contactHref} class="py-cta">{s.sec2Cta}</a>
				</div>
			</div>
		</section>

		<section class="svc-content" aria-label={s.contentTitle}>
			<div class="svc-content-inner">
				<h2 class="svc-content-title">{s.contentTitle}</h2>
				<p class="svc-content-text">{s.contentP1}</p>
				<p class="svc-content-text">{s.contentP2}</p>
				<p class="svc-content-text">{s.contentP3}</p>
				<div class="svc-tours-links">
					<a href={localizePath('/sunset-boat-tour', lang)}>{c('nav.tourSunset')}</a>
					<a href={localizePath('/navagio-shipwreck-boat-tour', lang)}>{c('nav.tourNavagio')}</a>
					<a href={localizePath('/blue-caves-boat-tour', lang)}>{c('nav.tourBlueCaves')}</a>
					<a href={localizePath('/keri-caves-turtle-island-boat-tour', lang)}>{c('nav.tourKeri')}</a>
				</div>
			</div>
		</section>
		<section class="svc-faq" aria-label={s.faqTitle}>
			<div class="svc-faq-inner">
				<h2 class="svc-faq-title">{s.faqTitle}</h2>
				<div class="svc-faq-item"><h3>{s.faq1Q}</h3><p>{s.faq1A}</p></div>
				<div class="svc-faq-item"><h3>{s.faq2Q}</h3><p>{s.faq2A}</p></div>
				<div class="svc-faq-item"><h3>{s.faq3Q}</h3><p>{s.faq3A}</p></div>
				<div class="svc-faq-item"><h3>{s.faq4Q}</h3><p>{s.faq4A}</p></div>
			</div>
		</section>
	</main>
	<Footer lang={lang} />

	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const header = document.querySelector('.hero-header');
			const heroSection = document.querySelector('.hero');
			if (header) {
				if (!heroSection) {
					header.classList.add('hero-header--scrolled');
				} else {
					const onScroll = () => {
						const heroH = heroSection.getBoundingClientRect().height;
						header.classList.toggle('hero-header--scrolled', window.scrollY >= heroH - 1);
					};
					onScroll();
					window.addEventListener('scroll', onScroll, { passive: true });
				}
			}
		});
	</script>
</body>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html {
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		font-family: 'Inter', system-ui, sans-serif;
		overflow-x: hidden;
	}
	body.license-free-body {
		padding-top: 0;
	}
</style>

<style>
	.license-free-page {
		min-height: 100vh;
	}

	.page-hero {
		position: relative;
		width: 100%;
		min-height: 50vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, #064250 0%, #0a5a6a 100%);
		overflow: hidden;
		padding-top: 5rem;
	}
	.page-hero-overlay {
		position: absolute;
		inset: 0;
		background: url('/images/0DF67F7B-8AA7-476C-BCEB-37E088D4925A.webp') center/cover no-repeat;
		opacity: 0.25;
	}
	.page-hero-content {
		position: relative;
		z-index: 1;
		text-align: center;
		padding: 3rem 2rem;
		max-width: 100%;
	}
	.page-hero-label {
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		color: rgba(255, 255, 255, 0.9);
		margin: 0 0 0.5rem 0;
		text-transform: uppercase;
	}
	.page-hero-title {
		white-space: nowrap;
		font-family: 'Fraunces', serif;
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		font-weight: 600;
		color: #fff;
		margin: 0 0 1rem 0;
		line-height: 1.2;
	}
	.page-hero-subtitle {
		font-size: 1.1rem;
		color: rgba(255, 255, 255, 0.9);
		margin: 0 0 1.5rem 0;
		line-height: 1.5;
	}
	.page-hero-cta {
		display: inline-block;
		padding: 0.9rem 2rem;
		background: #fff;
		color: #064250;
		text-decoration: none;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		border-radius: 4px;
		transition: opacity 0.2s, transform 0.2s;
	}
	.page-hero-cta:hover {
		opacity: 0.95;
		transform: translateY(-1px);
	}

	/* Alternating image/text sections */
	.py-section {
		width: 100%;
	}
	.py-section-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		min-height: 450px;
	}
	.py-section-inner--full {
		grid-template-columns: 1fr;
	}
	.py-section-inner--full {
		min-height: auto;
	}
	.py-text--full {
		text-align: center;
		align-items: center;
		max-width: 800px;
		margin: 0 auto;
		padding: 5rem 3rem;
		width: 100%;
		box-sizing: border-box;
	}
	.py-text--full .py-desc {
		max-width: 60ch;
	}
	.py-text--full .py-cta {
		align-self: center;
	}
	.py-image-wrap {
		overflow: hidden;
	}
	.py-image-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		min-height: 400px;
	}
	.py-text {
		background: #f5f0e8;
		padding: 4rem 3rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1rem;
	}
	.py-section--reversed .py-image-wrap {
		order: 2;
	}
	.py-section--reversed .py-text {
		order: 1;
		background: #fff;
	}
	.py-label {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		color: #8b7765;
		margin: 0;
		text-transform: uppercase;
	}
	.py-title {
		font-family: 'Fraunces', serif;
		font-size: clamp(1.75rem, 3.5vw, 2.5rem);
		font-weight: 700;
		color: #1a1a1a;
		margin: 0;
		line-height: 1.2;
	}
	.py-desc {
		font-size: 1rem;
		line-height: 1.7;
		color: #444;
		margin: 0;
		max-width: 48ch;
	}
	.py-cta {
		display: inline-block;
		align-self: flex-start;
		padding: 0.9rem 2rem;
		background: #1a1a1a;
		color: #fff;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		text-decoration: none;
		transition: background 0.2s;
		margin-top: 0.5rem;
	}
	.py-cta:hover {
		background: #333;
	}

	@media (max-width: 900px) {
		.page-hero-title {
			white-space: normal;
		}
		.py-section-inner {
			grid-template-columns: 1fr;
		}
		.py-section--reversed .py-image-wrap {
			order: 0;
		}
		.py-section--reversed .py-text {
			order: 0;
		}
		.py-text {
			padding: 2.5rem 1.5rem;
		}
		.py-text--full {
			max-width: 100%;
			padding: 3rem 1.5rem;
		}
		.py-image-wrap img {
			min-height: 280px;
			max-height: 350px;
		}
	}
	@media (max-width: 600px) {
		.py-text {
			padding: 2rem 1.25rem;
		}
		.py-text--full {
			padding: 2.5rem 1.25rem;
		}
		.py-text--full .py-desc {
			max-width: 100%;
		}
		.py-image-wrap img {
			min-height: 220px;
			max-height: 300px;
		}
	}
	.svc-content { padding: 4rem 1.5rem 1rem; }
	.svc-content-inner { max-width: 760px; margin: 0 auto; text-align: center; }
	.svc-content-title { font-family: 'Fraunces', serif; font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 700; color: #1a1a1a; margin: 0 0 1rem; line-height: 1.2; }
	.svc-content-text { font-size: 1.05rem; line-height: 1.8; color: #333; margin: 0 0 1.1rem; }
	.svc-tours-links { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; margin-top: 1.5rem; }
	.svc-tours-links a { display: inline-block; padding: 0.5rem 1rem; border: 1px solid #d9d2c7; border-radius: 999px; color: #064250; text-decoration: none; font-size: 0.9rem; font-weight: 500; }
	.svc-tours-links a:hover { border-color: #2aa8a0; }
	.svc-faq { padding: 3rem 1.5rem 4.5rem; }
	.svc-faq-inner { max-width: 800px; margin: 0 auto; }
	.svc-faq-title { font-family: 'Fraunces', serif; font-size: clamp(1.6rem, 3vw, 2.25rem); font-weight: 700; color: #1a1a1a; text-align: center; margin: 0 0 2rem; }
	.svc-faq-item { border-top: 1px solid #e7ded0; padding: 1.25rem 0; }
	.svc-faq-item h3 { font-size: 1.1rem; font-weight: 600; color: #1a1a1a; margin: 0 0 0.5rem; }
	.svc-faq-item p { font-size: 1rem; line-height: 1.65; color: #444; margin: 0; }
</style>
