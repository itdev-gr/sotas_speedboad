---
import SEOHead from '../components/SEOHead.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import PrivateYachtingBody from '../components/pages/PrivateYachtingBody.astro';
import { privateYachting } from '../i18n/pages/private-yachting';

const lang = 'en';
const s = privateYachting[lang];
---

<html lang={lang}>
	<head>
		<SEOHead
			title={s.seoTitle}
			description={s.seoDescription}
			lang={lang}
			basePath="/private-yachting"
			translated={true}
			ogImage="https://rentaboatzakynthos.com/images/IMG_0112.jpeg"
		/>
		<SchemaOrg page="private-yachting" />
	</head>
	<PrivateYachtingBody lang={lang} />
</html>
