---
import SEOHead from '../../components/SEOHead.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import ContactBody from '../../components/pages/ContactBody.astro';
import { contact } from '../../i18n/pages/contact';
import { isLocale, DEFAULT_LOCALE, type Locale } from '../../i18n/config';

export function getStaticPaths() {
	return [{ params: { lang: 'de' } }, { params: { lang: 'fr' } }, { params: { lang: 'it' } }, { params: { lang: 'ru' } }, { params: { lang: 'el' } }];
}

const { lang: langParam } = Astro.params;
const lang: Locale = isLocale(langParam) && langParam !== DEFAULT_LOCALE ? langParam : 'de';
const s = contact[lang];
---

<html lang={lang}>
	<head>
		<SEOHead
			title={s.seoTitle}
			description={s.seoDescription}
			lang={lang}
			basePath="/contact"
			translated={true}
		/>
		<SchemaOrg page="contact" />
	</head>
	<ContactBody lang={lang} />
</html>
