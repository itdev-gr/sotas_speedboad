---
import SEOHead from '../../components/SEOHead.astro';
import ToursBody from '../../components/pages/ToursBody.astro';
import { tours } from '../../i18n/pages/tours';
import { isLocale, DEFAULT_LOCALE, type Locale } from '../../i18n/config';

export function getStaticPaths() {
	return [{ params: { lang: 'de' } }, { params: { lang: 'fr' } }, { params: { lang: 'it' } }, { params: { lang: 'ru' } }];
}

const { lang: langParam } = Astro.params;
const lang: Locale = isLocale(langParam) && langParam !== DEFAULT_LOCALE ? langParam : 'de';
const s = tours[lang];
---

<html lang={lang}>
	<head>
		<SEOHead
			title={s.seoTitle}
			description={s.seoDescription}
			lang={lang}
			basePath="/tours"
			translated={true}
			ogImage="https://rentaboatzakynthos.com/images/unnamed.jpg"
		/>
	</head>
	<ToursBody lang={lang} />
</html>
