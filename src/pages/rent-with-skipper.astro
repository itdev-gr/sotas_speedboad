---
export const prerender = false;
import SEOHead from '../components/SEOHead.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import RentWithSkipperBody from '../components/pages/RentWithSkipperBody.astro';
import { rentWithSkipper } from '../i18n/pages/rent-with-skipper';
const lang = 'en';
const s = rentWithSkipper[lang];
---
<html lang={lang}><head>
	<SEOHead title={s.seoTitle} description={s.seoDescription} lang={lang} basePath="/rent-with-skipper" translated={true} ogImage="https://rentaboatzakynthos.com/images/image_skipper.png" />
	<SchemaOrg page="rent-with-skipper" />
</head><RentWithSkipperBody lang={lang} /></html>
