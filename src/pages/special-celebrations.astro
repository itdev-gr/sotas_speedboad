---
import SEOHead from '../components/SEOHead.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import SpecialCelebrationsBody from '../components/pages/SpecialCelebrationsBody.astro';
import { specialCelebrations } from '../i18n/pages/special-celebrations';

const lang = 'en';
const s = specialCelebrations[lang];
---

<html lang={lang}>
	<head>
		<SEOHead
			title={s.seoTitle}
			description={s.seoDescription}
			lang={lang}
			basePath="/special-celebrations"
			translated={true}
		/>
		<SchemaOrg page="special-celebrations" />
	</head>
	<SpecialCelebrationsBody lang={lang} />
</html>
