---
export const prerender = false;
import SEOHead from '../components/SEOHead.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import LicenseFreeBody from '../components/pages/LicenseFreeBody.astro';
import { licenseFree } from '../i18n/pages/license-free-rent';

const lang = 'en';
const s = licenseFree[lang];
---

<html lang={lang}>
	<head>
		<SEOHead
			title={s.seoTitle}
			description={s.seoDescription}
			lang={lang}
			basePath="/license-free-rent"
			translated={true}
		/>
		<SchemaOrg page="license-free-rent" />
	</head>
	<LicenseFreeBody lang={lang} />
</html>
