---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import FaqBody from '../components/pages/FaqBody.astro';
import { faq } from '../i18n/pages/faq';

const lang = 'en';
const s = faq[lang];
---

<html lang={lang}>
	<head>
		<SEOHead title={s.seoTitle} description={s.seoDescription} lang={lang} basePath="/faq" translated={true} />
		<SchemaOrg page="faq" />
	</head>
	<FaqBody lang={lang} />
</html>
