---
import SEOHead from '../components/SEOHead.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import ContactBody from '../components/pages/ContactBody.astro';
import { contact } from '../i18n/pages/contact';

const lang = 'en';
const s = contact[lang];
---

<html lang={lang}>
	<head>
		<SEOHead
			title={s.seoTitle}
			description={s.seoDescription}
			lang={lang}
			basePath="/contact"
			translated={true}
		/>
		<SchemaOrg page="contact" />
	</head>
	<ContactBody lang={lang} />
</html>
